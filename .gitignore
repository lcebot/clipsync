# windows/app/config.json holds the PSK and is never committed. No template is carried either: the
# settings window opens on the defaults when the file is absent and writes a complete one on Apply,
# so there was nothing for a committed copy to do except be the one tracked file that could leak a
# key. The release workflow fails if it ever reappears there.
#
# The paths follow clipsync_config.py, which resolves both config.json and clipsync.log from its own
# folder — so they moved into app/ when it did. install-state.json stays at the top because it
# belongs to install.ps1, which stayed too.
windows/app/config.json
windows/app/config.json.tmp
windows/app/clipsync.log
windows/app/clipsync.log.old
windows/install-state.json
windows/app/received/
# The same folder one level up, which is where a files_dir of "received" resolved before
# clipsync_config moved into app/. Nothing writes here any more, but an existing install still has
# one, and the files in it are the user's clipboard history in the clear.
windows/received/
__pycache__/
