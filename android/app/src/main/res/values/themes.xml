<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Expressive (material 1.14+): expressive shapes / motion / type for every
         component that takes its style from the theme; dynamic colour on Android 12+, day/night. -->
    <style name="Theme.ClipSync" parent="Theme.Material3Expressive.DynamicColors.DayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Segmented-button segment: normal button type (labelLarge); three labels fit a phone width
         once minWidth is dropped and the default button padding is trimmed a little.
         Currently unused — the connection mode it served became two switches — and kept for the
         device-type selector of docs/p2p-plan.md §2. -->
    <style name="ClipSync.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
    </style>

    <!-- Inside of every settings card. The switches that govern the groups are rows above their
         cards, not inside them, so every card body holds the same kind of thing and one padding fits. -->
    <style name="ClipSync.CardBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
    </style>


    <!-- An action inside a settings card: "Generate random PSK key", "Add address".

         Outlined, not borderless. Its left edge then sits exactly where the outlined text fields'
         left edges sit — 12dp into the card body for both — so the alignment that carries the page is
         outline to outline, between two things of the same kind. That is also what makes an icon
         harmless again: with a border to read, nothing depends on where the label happens to land.
         The stroke and its colour come from the parent, which is the point of using it — Expressive's
         outlined button strokes ?attr/colorOutlineVariant at ?attr/containerStrokeWidth, and there is
         no Expressive ".Icon" variant to reach for because its padding is already symmetric.

         The padding items below are probably redundant under this parent, which supplies 16dp through
         containerPaddingStart/End. They are kept because this exact set is what was confirmed correct
         on a device, and because the inherited absolute pair is still live underneath:
           paddingLeft/Right  Widget.Material3.Button — the parent two levels up — sets
                              android:paddingLeft/Right to m3_btn_padding_left = 24dp, and the
                              Expressive child adds paddingStart/End WITHOUT clearing them. Both stay
                              live in the merged attribute set, and the absolute pair is what was
                              winning: 24dp on each side, which is why the label looked centred.
                              Setting only paddingStart does nothing on its own.
           paddingStart/End   the relative pair, for the RTL-aware path.
           insetLeft/Right    MaterialButtonHelper folds insetLeft into paddingStart and draws the
                              background inside it, so a non-zero inset offsets the label.
           minWidth           the AppCompat button chain supplies one; a shorter label than that
                              leaves the button stretched.
           gravity            the inherited gravity is centre, so any stretch pushes the label right.
         Named parent rather than ?attr/borderlessButtonStyle because a style cannot take an attribute
         as its parent, and the padding being overridden is the parent's own. -->
    <style name="ClipSync.SettingsButton" parent="Widget.Material3Expressive.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!-- small group header above each block of settings -->
    <style name="ClipSync.SectionTitle" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <!-- A heading, and said so. Without it a screen reader has to walk every field of a section
             to reach the next one; with it the sections are navigable the way they look. -->
        <item name="android:accessibilityHeading">true</item>
    </style>
</resources>
