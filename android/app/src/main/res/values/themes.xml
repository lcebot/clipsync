<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Expressive (material 1.14+): expressive shapes / motion / type for every
         component that takes its style from the theme, day/night.

         NOT the .DynamicColors. parent any more, and the difference is the whole point. That parent
         hard-wires every role to @android:color/system_*, so there is nowhere for an app's own
         colours to live: where the system has no palette to give, it falls back to Material's
         baseline purple, which is the library's identity rather than this app's. The roles below are
         ClipSync's own, and ClipSyncApp overlays the wallpaper-derived palette on top *when the
         system provides one* — the same result on a device with Monet, and ours rather than
         Material's on a device without.

         Every role is bound, not a chosen few: components pick their own, so a partial scheme shows
         the baseline through wherever this list stops. See values/colors.xml. -->
    <style name="Theme.ClipSync" parent="Theme.Material3Expressive.DayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/brand_inverse_primary</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>

        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorOnTertiary">@color/brand_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/brand_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/brand_on_tertiary_container</item>

        <item name="colorError">@color/brand_error</item>
        <item name="colorOnError">@color/brand_on_error</item>
        <item name="colorErrorContainer">@color/brand_error_container</item>
        <item name="colorOnErrorContainer">@color/brand_on_error_container</item>

        <item name="android:colorBackground">@color/brand_surface</item>
        <item name="colorOnBackground">@color/brand_on_surface</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorSurfaceVariant">@color/brand_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/brand_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/brand_inverse_on_surface</item>
        <!-- No colorSurfaceTint: that is a Compose role, not one the Views library declares, and
             naming it fails resource linking. The elevation tint here is elevationOverlayColor,
             which the parent already points at ?attr/colorPrimary — a theme reference, so it
             follows whatever colorPrimary ends up being and needs no restating. -->

        <item name="colorSurfaceDim">@color/brand_surface_dim</item>
        <item name="colorSurfaceBright">@color/brand_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/brand_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/brand_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/brand_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/brand_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/brand_surface_container_highest</item>

        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorOutlineVariant">@color/brand_outline_variant</item>
    </style>

    <!-- The roles whose MEANING is fixed, re-pinned on top of the wallpaper palette.

         Monet is a palette, not a vocabulary. It is welcome to decide what "this app's accent" looks
         like — that is the whole point of it — but it does not get a say in what *error* looks like,
         because red is not a decorative choice here: it is the difference between "a target is
         deferring to a better route" and "a target you need to fix", and between the battery card
         and the rest of the settings page. A wallpaper that turned the error container green would
         leave those distinctions drawn in a colour that means the opposite of what they say.

         Applied by ClipSyncApp AFTER the dynamic overlay, because that overlay is applied with
         force=true and would otherwise win. Whether it currently touches these roles at all is not
         the point — Android 12's palette had no error hue, later ones do, and this app should not
         have to re-check which platform version decided what. Pinning makes the guarantee ours.

         Only the error family. colorTertiary — the peer sheet's "asleep" accent — is deliberately
         NOT here: that one is an accent doing an accent's job, and it should follow the wallpaper
         with everything else. -->
    <style name="ThemeOverlay.ClipSync.Semantic" parent="">
        <item name="colorError">@color/brand_error</item>
        <item name="colorOnError">@color/brand_on_error</item>
        <item name="colorErrorContainer">@color/brand_error_container</item>
        <item name="colorOnErrorContainer">@color/brand_on_error_container</item>
    </style>

    <!-- Segmented-button segment: normal button type (labelLarge); three labels fit a phone width
         once minWidth is dropped and the default button padding is trimmed a little.
         Currently unused — the connection mode it served became two switches — and kept for the
         device-type selector of docs/p2p-plan.md §2. -->
    <style name="ClipSync.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
    </style>

    <!-- Inside of every settings card. The switches that govern the groups are rows above their
         cards, not inside them, so every card body holds the same kind of thing and one padding fits. -->
    <style name="ClipSync.CardBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
    </style>


    <!-- An action inside a settings card: "Generate random PSK key", "Add address".

         Outlined, not borderless. Its left edge then sits exactly where the outlined text fields'
         left edges sit — 12dp into the card body for both — so the alignment that carries the page is
         outline to outline, between two things of the same kind. That is also what makes an icon
         harmless again: with a border to read, nothing depends on where the label happens to land.
         The stroke and its colour come from the parent, which is the point of using it — Expressive's
         outlined button strokes ?attr/colorOutlineVariant at ?attr/containerStrokeWidth, and there is
         no Expressive ".Icon" variant to reach for because its padding is already symmetric.

         The padding items below are probably redundant under this parent, which supplies 16dp through
         containerPaddingStart/End. They are kept because this exact set is what was confirmed correct
         on a device, and because the inherited absolute pair is still live underneath:
           paddingLeft/Right  Widget.Material3.Button — the parent two levels up — sets
                              android:paddingLeft/Right to m3_btn_padding_left = 24dp, and the
                              Expressive child adds paddingStart/End WITHOUT clearing them. Both stay
                              live in the merged attribute set, and the absolute pair is what was
                              winning: 24dp on each side, which is why the label looked centred.
                              Setting only paddingStart does nothing on its own.
           paddingStart/End   the relative pair, for the RTL-aware path.
           insetLeft/Right    MaterialButtonHelper folds insetLeft into paddingStart and draws the
                              background inside it, so a non-zero inset offsets the label.
           minWidth           the AppCompat button chain supplies one; a shorter label than that
                              leaves the button stretched.
           gravity            the inherited gravity is centre, so any stretch pushes the label right.
         Named parent rather than ?attr/borderlessButtonStyle because a style cannot take an attribute
         as its parent, and the padding being overridden is the parent's own. -->
    <style name="ClipSync.SettingsButton" parent="Widget.Material3Expressive.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!-- small group header above each block of settings -->
    <style name="ClipSync.SectionTitle" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <!-- A heading, and said so. Without it a screen reader has to walk every field of a section
             to reach the next one; with it the sections are navigable the way they look. -->
        <item name="android:accessibilityHeading">true</item>
    </style>
</resources>
