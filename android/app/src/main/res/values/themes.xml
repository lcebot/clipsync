<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Expressive (material 1.14+): expressive shapes / motion / type for every
         component that takes its style from the theme; dynamic colour on Android 12+, day/night. -->
    <style name="Theme.ClipSync" parent="Theme.Material3Expressive.DynamicColors.DayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- segmented-button segment: fits three labels on a phone width without ellipsis -->
    <style name="ClipSync.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
    </style>

    <!-- small group header above each block of settings -->
    <style name="ClipSync.SectionTitle" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
