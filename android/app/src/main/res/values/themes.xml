<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window only. Every screen is Compose and takes its colours, type and shapes from
         ClipSyncTheme, so this theme has two jobs: no action bar, and a window background in the
         app's own surface colour, so the frame before the first composition matches the one after it
         in both appearances (brand_surface resolves per appearance through values-night). -->
    <style name="Theme.ClipSync" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/brand_surface</item>
    </style>
</resources>
