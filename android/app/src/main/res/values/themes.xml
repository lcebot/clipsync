<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Expressive (material 1.14+): expressive shapes / motion / type for every
         component that takes its style from the theme; dynamic colour on Android 12+, day/night. -->
    <style name="Theme.ClipSync" parent="Theme.Material3Expressive.DynamicColors.DayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Segmented-button segment: normal button type (labelLarge); three labels fit a phone width
         once minWidth is dropped and the default button padding is trimmed a little.
         Currently unused — the connection mode it served became two switches — and kept for the
         device-type selector of docs/p2p-plan.md §2. -->
    <style name="ClipSync.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
    </style>

    <!-- Inside of a settings card whose controls are outlined text fields. An outlined box fills its
         own row edge to edge, so 12dp of card padding is 12dp of visible clearance. -->
    <style name="ClipSync.CardBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Inside of a settings card whose controls are switch rows and sliders. These carry their own
         clear space: a MaterialSwitch measures 48dp (minTouchTargetSize) around a 32dp track, so 8dp
         of it is already empty, and a slider and a text button are the same story. 12dp of card
         padding on top of that reads as a wider gap than the same 12dp above an outlined box. 4dp
         brings the first visible pixel to the same place. -->
    <style name="ClipSync.CardBody.Rows" parent="ClipSync.CardBody">
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- small group header above each block of settings -->
    <style name="ClipSync.SectionTitle" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
