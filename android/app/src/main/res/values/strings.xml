<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">ClipSync</string>
    <!-- Shown as the module description in the LSPosed manager and in the module repository:
         PackageManager reads it from android:description on <application>. -->
    <string name="app_desc">Share one clipboard across your rooted Android devices and your Windows PC.</string>

    <!-- actions -->
    <string name="action_stop">Stop</string>
    <string name="action_apply">Apply</string>
    <string name="action_start">Start</string>

    <!-- navigation -->
    <string name="nav_settings">Settings</string>
    <string name="nav_log">Log</string>

    <!-- battery card -->
    <string name="battery_on">Battery optimisation is on: the system may freeze ClipSync in the background (nothing is copied or received until you reopen it).</string>
    <string name="battery_still_frozen">The system still froze ClipSync in the background. Check the log for "root keep-alive" and "hooked" (LSPosed); on this ROM also allow autostart / no background restrictions and lock ClipSync in Recents.</string>
    <string name="battery_allow">Allow</string>

    <!-- connection -->
    <string name="section_connection">Connection</string>
    <string name="hint_port">Port</string>
    <string name="hint_psk">PSK key (64 hex)</string>
    <string name="psk_generate">Generate random PSK key</string>
    <string name="psk_replace_title">Replace the key?</string>
    <string name="psk_replace_body">Every other device is using the current key and will stop connecting until you set the new one there too.</string>
    <string name="psk_replace_ok">Replace</string>
    <!-- The two switches name how a peer is found, not the route to it: a listed address is very
         often a LAN address too. Named this way, neither needs a supporting line. -->
    <string name="switch_discovery">Local network discovery</string>
    <string name="switch_direct">Direct connections</string>
    <!-- Numbered, because the list holds several identical-looking fields and a screen reader has
         nothing else to tell them apart by. -->
    <string name="hint_peer">Address %1$d</string>
    <!-- These two carry the weight a supporting line would, which is why they say what belongs in
         the field rather than just that it is empty. The way out differs with the row: the last one
         cannot be removed, so it names the switch instead. %1$s is switch_direct, so renaming the
         switch does not leave the message behind. -->
    <string name="peer_empty">Enter a host name or IP address, or remove this row</string>
    <string name="peer_empty_last">Enter a host name or IP address, or turn off %1$s</string>
    <!-- Carries no "+": the button has no icon (see page_settings.xml) and a typographic plus in a
         label is not how M3 writes a text button. A plain verb phrase says it. -->
    <string name="peer_add">Add address</string>
    <string name="peer_remove">Remove</string>
    <string name="peer_duplicate">Already listed above</string>
    <string name="peer_is_self">That is this device</string>
    <!-- This device's own addresses (docs/p2p-plan.md §4a). No switch: an empty list already means
         "this device has no name of its own". -->
    <string name="section_own">This device\'s addresses</string>
    <!-- No full stop: nothing else on this page ends a supporting line with one. -->
    <string name="own_help">Used to recognise itself and avoid a network loop</string>
    <!-- Labels for the card's click action, so a screen reader can say what pressing would do. -->
    <string name="own_expand">Show this device\'s addresses</string>
    <string name="own_collapse">Hide this device\'s addresses</string>
    <!-- And the state it is in now, which is a different question from what the press would do. -->
    <string name="own_state_expanded">Expanded</string>
    <string name="own_state_collapsed">Collapsed</string>
    <string name="browse_label">mDNS browse timeout: %1$d ms</string>
    <!-- Both switches off leaves no way to reach anything. Shown under the pair, because it is about
         the pair; neither switch on its own is wrong. -->
    <string name="paths_none">Turn on at least one of these. With both off there is no way to reach another device.</string>

    <!-- transfer limits -->
    <string name="section_limits">Transfer limits</string>
    <string name="hint_text_kb">Text (KB)</string>
    <string name="hint_file_mb">File (MB)</string>
    <string name="hint_file_mb_local">File on LAN (MB)</string>
    <string name="threads_label">Parallel connections per file: %1$d</string>

    <!-- received files -->
    <string name="section_files">Received files</string>
    <string name="hint_path">Path</string>
    <string name="helper_path">Under Download/ or Documents/ on internal storage</string>
    <string name="hint_keep_hours">Keep unused for (hours, 0 = forever)</string>
    <string name="hint_keep_mb">Keep at most (MB, 0 = unlimited)</string>

    <!-- log page -->
    <string name="log_copy">Copy</string>
    <string name="log_clear">Clear</string>

    <!-- Status chip in the app bar. Five states, distinct because the answer to "what do I do now"
         differs for each: Stopped needs a button, No network needs the network fixed, Idle needs
         nothing. Disconnected is gone — with several peers it carried no information the sheet does
         not carry better. See docs/p2p-plan.md §11. -->
    <string name="state_stopped">Stopped</string>
    <string name="state_connecting">Connecting…</string>
    <string name="state_no_network">No network</string>
    <string name="state_idle">Idle</string>
    <string name="state_connected">Connected (%1$d)</string>
    <string name="state_not_running">not running — restarting</string>
    <string name="state_autostart_off">auto-start off</string>
    <string name="target_discovery">Local network</string>
    <!-- Shown against "Local network" in the sheet while discovery is on and has found nothing. It
         says what was looked for rather than just "nothing", because the three ordinary causes —
         the other device asleep, mDNS blocked by the access point, client isolation — are all
         invisible from here and none of them is a fault of this device. -->
    <string name="discovery_none">No other devices are advertising on this network</string>

    <!-- connection sheet -->
    <string name="sheet_title">Peers</string>
    <string name="sheet_on_lan">On this network</string>
    <string name="sheet_over_internet">Over the internet</string>
    <string name="sheet_not_connected">Not connected</string>
    <string name="sheet_none">No peers connected</string>
    <string name="peer_same_as">Same device as %1$s</string>
    <string name="peer_disconnected">Disconnected</string>
    <string name="dialog_tap_to_copy">Tap a row to copy it.</string>

    <!-- snackbars -->
    <string name="snack_copied">Copied</string>
    <string name="snack_stopped">Service stopped (auto-start off until Apply)</string>
    <string name="snack_applied">Saved and applied</string>
    <string name="snack_log_copied">Log copied</string>
    <string name="snack_save_failed">Save failed: %1$s</string>
</resources>
