<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">ClipSync</string>
    <!-- Shown as the module description in the LSPosed manager and in the module repository:
         PackageManager reads it from android:description on <application>. -->
    <string name="app_desc">Share one clipboard across your rooted Android devices and your Windows PC.</string>

    <!-- actions -->
    <string name="action_stop">Stop</string>
    <string name="action_apply">Apply</string>
    <string name="action_start">Start</string>

    <!-- navigation -->
    <string name="nav_settings">Settings</string>
    <string name="nav_log">Log</string>

    <!-- battery card -->
    <string name="battery_on">Battery optimisation is on: the system may freeze ClipSync in the background (nothing is copied or received until you reopen it).</string>
    <string name="battery_still_frozen">The system still froze ClipSync in the background. Check the log for "root keep-alive" and "hooked" (LSPosed); on this ROM also allow autostart / no background restrictions and lock ClipSync in Recents.</string>
    <string name="battery_allow">Allow</string>

    <!-- connection -->
    <string name="section_connection">Connection</string>
    <string name="hint_port">Port</string>
    <string name="hint_psk">PSK key (64 hex)</string>
    <string name="psk_rotate">Rotate key automatically</string>
    <!-- Shown once in a dialog when the checkbox is ticked. Says the three things the user cannot
         see happening: how often, that devices left off for a while are still let in, and what the
         one bad outcome is and how to recover from it. The hours are the real constants; if
         Keys.java changes, this changes with it. -->
    <string name="psk_rotate_help">Every 48 hours this device makes a new key and passes it to the others, so a key that leaks is only useful for a few days. Devices that were switched off still connect — the last few keys keep working for about a week. A device left off longer than that has to be paired again.</string>
    <string name="psk_generate">Generate random PSK key</string>
    <string name="psk_replace_title">Replace the key?</string>
    <string name="psk_replace_body">Every other device is using the current key and will stop connecting until you set the new one there too.</string>
    <string name="psk_replace_ok">Replace</string>
    <!-- The two switches name how a peer is found, not the route to it: a listed address is very
         often a LAN address too. Named this way, neither needs a supporting line. -->
    <string name="switch_discovery">Local network discovery</string>
    <string name="switch_direct">Direct connections</string>
    <!-- Numbered, because the list holds several identical-looking fields and a screen reader has
         nothing else to tell them apart by. -->
    <string name="hint_peer">Address %1$d</string>
    <!-- These two carry the weight a supporting line would, which is why they say what belongs in
         the field rather than just that it is empty. The way out differs with the row: the last one
         cannot be removed, so it names the switch instead. %1$s is switch_direct, so renaming the
         switch does not leave the message behind. -->
    <string name="peer_empty">Enter a host name or IP address, or remove this row</string>
    <string name="peer_empty_last">Enter a host name or IP address, or turn off %1$s</string>
    <!-- Carries no "+": the button has no icon (see page_settings.xml) and a typographic plus in a
         label is not how M3 writes a text button. A plain verb phrase says it. -->
    <string name="peer_add">Add address</string>
    <string name="peer_remove">Remove</string>
    <string name="peer_duplicate">Already listed above</string>
    <string name="peer_is_self">That is this device</string>
    <!-- This device's own addresses (docs/p2p-plan.md §4a). No switch: an empty list already means
         "this device has no name of its own". -->
    <string name="section_own">This device\'s addresses</string>
    <!-- No full stop: nothing else on this page ends a supporting line with one. -->
    <string name="own_help">Used to recognise itself and avoid a network loop</string>
    <!-- Labels for the card's click action, so a screen reader can say what pressing would do. -->
    <string name="own_expand">Show this device\'s addresses</string>
    <string name="own_collapse">Hide this device\'s addresses</string>
    <!-- And the state it is in now, which is a different question from what the press would do. -->
    <string name="own_state_expanded">Expanded</string>
    <string name="own_state_collapsed">Collapsed</string>
    <string name="browse_label">mDNS browse timeout: %1$d ms</string>
    <!-- Relay opt-out switch (docs/p2p-plan.md §8). The switch declines the relay role, which is
         useful for a device on battery that would stay awake while relaying. -->
    <string name="switch_relay_opt_out">Decline relay requests</string>
    <string name="relay_opt_out_help">Other devices on the LAN may ask this one to relay a file. Turn this on to decline, so the device can sleep sooner.</string>

    <!-- Both switches off leaves no way to reach anything. Shown under the pair, because it is about
         the pair; neither switch on its own is wrong. -->
    <string name="paths_none">Turn on at least one of these. With both off there is no way to reach another device.</string>

    <!-- transfer limits -->
    <string name="section_limits">Transfer limits</string>
    <string name="hint_text_kb">Text (KB)</string>
    <string name="hint_file_mb">File (MB)</string>
    <string name="hint_file_mb_local">File on LAN (MB)</string>
    <string name="threads_label">Parallel connections per file: %1$d</string>

    <!-- received files -->
    <string name="section_files">Received files</string>
    <string name="hint_path">Path</string>
    <string name="helper_path">Under Download/ or Documents/ on internal storage</string>
    <string name="hint_keep_hours">Keep unused for (hours, 0 = forever)</string>
    <string name="hint_keep_mb">Keep at most (MB, 0 = unlimited)</string>

    <!-- log page -->
    <string name="log_copy">Copy</string>
    <string name="log_clear">Clear</string>

    <!-- Status chip in the app bar. Five states, distinct because the answer to "what do I do now"
         differs for each: Stopped needs a button, No network needs the network fixed, Idle needs
         nothing. Disconnected is gone — with several peers it carried no information the sheet does
         not carry better. See docs/p2p-plan.md §11. -->
    <string name="state_stopped">Stopped</string>
    <string name="state_connecting">Connecting…</string>
    <string name="state_no_network">No network</string>
    <string name="state_idle">Idle</string>
    <string name="state_connected">Connected (%1$d)</string>
    <string name="state_relay">Relay (%1$d)</string>
    <string name="state_not_running">not running — restarting</string>
    <string name="state_autostart_off">auto-start off</string>
    <string name="target_discovery">Local network</string>
    <!-- Shown against "Local network" in the sheet while discovery is on and has found nothing. It
         says what was looked for rather than just "nothing", because the three ordinary causes —
         the other device asleep, mDNS blocked by the access point, client isolation — are all
         invisible from here and none of them is a fault of this device. -->
    <string name="discovery_none">No other devices are advertising on this network</string>

    <!-- connection sheet -->
    <string name="sheet_title">Peers</string>
    <string name="sheet_on_lan">On this network</string>
    <string name="sheet_over_internet">Over the internet</string>
    <string name="sheet_indirect">Indirect devices</string>
    <string name="sheet_not_connected">Not connected</string>
    <string name="sheet_none">No peers connected</string>
    <!-- §8: shown in the status sheet while this device is actively relaying files for others. -->
    <string name="sheet_relaying">Acting as LAN relay</string>
    <string name="peer_same_as">Same device as %1$s</string>
    <string name="peer_disconnected">Disconnected</string>
    <!-- A peer that announced it was going idle, rather than one that simply went quiet. The same
         word the chip uses for this device in the same state, deliberately: it is the same state,
         and naming it twice would suggest otherwise. The half after the dash is what makes it
         actionable — or rather, what makes it clearly *not* actionable. -->
    <string name="peer_idle">Idle — screen off</string>
    <!-- No trailing full stop and no object: every user-facing string on this side is a short phrase,
         and "it" adds nothing a card the finger is already over does not say. -->
    <string name="dialog_tap_to_copy">Tap a card to copy</string>
    <!-- Field labels inside a device card. Short, because they share a column with each other and
         the column is as wide as the longest of them. No trailing colon: the gap between the two
         columns is what separates a label from its value, and a colon in front of that gap reads as
         punctuation left over from a sentence that is not there. -->
    <string name="field_id">ID</string>
    <string name="field_type">Type</string>
    <string name="field_address">Address</string>
    <string name="field_via">Via</string>
    <string name="field_reason">Reason</string>

    <!-- pairing (docs/p2p-plan.md §12). "Pair" throughout, matching _clipsync-pair._tcp and
         PAIR_ASK: a separate user-facing word would only mean the log, the sheet and the settings
         page each naming the same act differently. -->
    <!-- Plural: one window hands the key to as many devices as walk up to it while the code is
         showing, so promising "a device" would undersell what pressing it does. -->
    <string name="pair_button">Pair new devices</string>
    <string name="setup_button">Set up ClipSync</string>
    <!-- Pairing cannot run with local discovery off, at either end. Said rather than done silently:
         a control that quietly changes another one is worse than either refusing or asking. -->
    <string name="pair_turned_discovery_on">Local network discovery turned on — pairing needs it</string>
    <string name="pair_no_key">Set a PSK key first — there is nothing to share yet</string>

    <!-- offering: this device has the key -->
    <string name="pair_offer_title">Pair new devices</string>
    <!-- Says where to type it, because the code is useless on the device displaying it and that is
         not obvious the first time. Plural, and "each": the window does not close on the first one. -->
    <string name="pair_offer_body">On each new device, choose “I have another ClipSync device” and enter this code</string>
    <!-- Six DIGITS, not six dashes, and greyed rather than in the code's own colour. Digits because
         a dash and a digit do not draw to the same height, so a row of dashes still left the line to
         grow when the real code replaced it — the one thing the placeholder exists to prevent. Grey
         because six plausible digits in the code's colour are six digits somebody will try to type. -->
    <string name="pair_code_placeholder">114514</string>
    <string name="pair_opening">Starting</string>
    <!-- The countdown is the only "waiting" wording: a plain one would be replaced within a frame
         by this, and two strings for one moment is one too many. -->
    <string name="pair_waiting_for">Waiting — %1$d s left</string>
    <!-- One line per device, appended under the code while the window stays open. -->
    <string name="pair_offer_gave">%1$s has the key</string>
    <!-- The three ways a window can end, told apart on purpose: a timer running out with nobody
         joined invites another go, five wrong codes is worth saying out loud, and a window that
         did its job should say so rather than report the clock. -->
    <string name="pair_offer_over">Finished. Every device that took the key is connecting now.</string>
    <string name="pair_expired">Nobody joined before the code expired.</string>
    <string name="pair_burned">Too many wrong codes — the window was closed. Try again for a new code.</string>
    <string name="pair_cannot_open">Could not open a pairing window: %1$s</string>

    <!-- joining: this device wants the key -->
    <string name="pair_join_title">Pair with a device</string>
    <string name="pair_join_body">On the device that already works, open Settings and tap “Pair new devices”</string>
    <string name="pair_searching">Looking on this network</string>
    <string name="pair_none_found">Nothing is offering to pair on this network. Check that the other device has the pairing window open, and that both are on the same Wi-Fi.</string>
    <string name="pair_search_again">Look again</string>
    <string name="pair_pick">Found these. Pick the one showing a code.</string>
    <string name="pair_enter_code">Enter the code shown on %1$s</string>
    <string name="pair_code_hint">Six-digit code</string>
    <string name="pair_code_length">Six digits</string>
    <string name="pair_connect">Connect</string>
    <string name="pair_connecting">Connecting</string>
    <string name="pair_join_done">Paired with %1$s. The key is set and the service is restarting.</string>
    <string name="pair_close">Close</string>

    <!-- the welcome screen: the only thing a device with no key can usefully do -->
    <!-- Broken by hand, not left to wrap: the two halves are a pair and the line should land between
         them at every width, not wherever the measured text happens to run out. -->
    <string name="welcome_title">One clipboard,\nevery device</string>
    <string name="welcome_body">ClipSync keeps the clipboard the same on all of your devices, over your own network.</string>
    <string name="welcome_next">Get started</string>
    <string name="welcome_choose_title">Set up this device</string>
    <string name="welcome_choose_body">Every device shares one key. Take it from a device that already has it, or make one here and hand it out.</string>
    <string name="first_run_join">I have another ClipSync device</string>
    <string name="first_run_generate">This is my first device</string>
    <!-- The escape hatch, and a neutral button rather than a peer of the other two: typing 64 hex
         characters is what pairing exists to avoid. -->
    <string name="first_run_manual">Set up manually</string>
    <string name="pair_cannot_generate">Could not save the new key</string>

    <!-- snackbars -->
    <string name="snack_copied">Copied</string>
    <string name="snack_stopped">Service stopped (auto-start off until Apply)</string>
    <string name="snack_applied">Saved and applied</string>
    <string name="snack_log_copied">Log copied</string>
    <string name="snack_save_failed">Save failed: %1$s</string>
</resources>
