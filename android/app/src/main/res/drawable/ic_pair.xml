<?xml version="1.0" encoding="utf-8"?>
<!-- Two devices and the link between them.

     Stroked rather than filled, and that is a choice about this icon rather than a shortcut: an
     outline reads as "two separate things joined", which is what pairing is, where a solid pair of
     blocks reads as one object. It also sits beside ic_dice on the same column of buttons, and a
     filled glyph next to a stroked one is the pair that looks wrong.

     Black, tinted at use like every other icon here (app:icon takes the button's own colour). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- the phone, left -->
    <path
        android:pathData="M3.75,6.25 h4.5 v11.5 h-4.5 z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- the other device, right: wider and shorter, so the two read as different kinds of thing
         rather than as one shape repeated -->
    <path
        android:pathData="M14.25,4.75 h6 v9 h-6 z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
    <path
        android:pathData="M17.25,13.75 v3.5 M15.25,17.25 h4"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- the link, dashed by being two strokes: a solid rule would read as an object of its own -->
    <path
        android:pathData="M9.25,11 h1.5 M12.25,11 h1.5"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
</vector>
