<?xml version="1.0" encoding="utf-8"?>
<!-- Pairing, both ends of it (docs/p2p-plan.md §12).

     One layout for two roles, because they are the same conversation seen from opposite sides and
     share every part of it: a title, a line of explanation, something turning while waiting, and one
     button. The provider shows a code and waits; the joiner looks, picks, and types the code it is
     being shown. PairSheet turns the pieces on and off.

     The same surface as the peer sheet — a bottom sheet, which also means predictive back for free.
     24dp gutters, matching it, so the two read as one app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pair_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/pair_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/pair_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="4dp"
        android:lineSpacingExtra="2dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- The code, on the device that holds the key. Display type and wide tracking because it is
         read aloud across a room and typed on a phone in the other hand — six digits that run
         together are six digits typed wrong. Monospace so every digit takes the same width and the
         eye can group them without the text reflowing as they change. -->
    <TextView
        android:id="@+id/pair_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="24dp"
        android:gravity="center"
        android:fontFamily="monospace"
        android:letterSpacing="0.3"
        android:textAppearance="?attr/textAppearanceDisplaySmall"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone" />

    <!-- Waiting. An indeterminate spinner is honest about a browse: nothing here knows how long a
         multicast answer takes, and a determinate bar would be inventing one. -->
    <LinearLayout
        android:id="@+id/pair_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorSize="24dp"
            app:trackThickness="3dp" />

        <TextView
            android:id="@+id/pair_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Devices found, one card each, filled in by PairSheet. -->
    <LinearLayout
        android:id="@+id/pair_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/pair_code_layout"
        style="?attr/textInputOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        android:hint="@string/pair_code_hint"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/pair_code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="6"
            android:imeOptions="actionDone"
            android:fontFamily="monospace"
            android:letterSpacing="0.2" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pair_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        android:visibility="gone" />
</LinearLayout>
