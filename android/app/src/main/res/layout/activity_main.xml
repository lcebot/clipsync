<?xml version="1.0" encoding="utf-8"?>
<!-- Surface ladder, so the three chrome surfaces never read as one block:
       log pane   surfaceContainerLow   (recedes behind the text)
       nav bar    surfaceContainer      (M3 navigation bar default)
       lifted bar surfaceContainerHigh  (sits above both) -->
<!-- Edge-to-edge (mandatory from targetSdk 35): the insets are NOT consumed at the root. A root
     that pads itself would leave the bottom bar sitting above a blank strip of window background
     instead of its own container colour running to the screen edge, and would hide the top inset
     from the app bar. Instead each component that knows what to do with an inset gets it: the
     AppBarLayout and CollapsingToolbarLayout take the top one (fitsSystemWindows below), and
     BottomNavigationView pads itself for the bottom one on its own. Nothing in between handles
     insets, so nothing in between is displaced by them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Deliberately NOT fitsSystemWindows. A CoordinatorLayout that handles insets lays out every
         child that does not handle them itself *inside* those insets — bottom included. The FABs
         are such children, so the bottom inset would lift them off the navigation bar, and when the
         IME opens it would lift them by the whole keyboard a second time, on top of the resize that
         has already moved them. The top inset is what the app bar needs, and it takes that itself
         (fitsSystemWindows below); the bottom belongs to the navigation bar view alone. -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== M3 "medium" collapsing top app bar: title scaling, insets and lift-on-scroll
             are the component's own. The status chip is the toolbar's only menu action, so the
             toolbar places it and pins it in the corner at every collapse offset. ===== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            app:liftOnScroll="true"
            app:liftOnScrollColor="?attr/colorSurfaceContainerHigh"
            app:liftOnScrollTargetViewId="@+id/page_settings">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing"
                style="?attr/collapsingToolbarLayoutMediumStyle"
                android:layout_width="match_parent"
                android:layout_height="?attr/collapsingToolbarLayoutMediumSize"
                android:fitsSystemWindows="true"
                app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
                app:titleCollapseMode="scale"
                app:contentScrim="?attr/colorSurfaceContainerHigh"
                app:maxLines="1"
                app:title="@string/app_name">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:layout_collapseMode="pin">

                    <!-- Connection status. A direct Toolbar child, not a menu action view: the
                         Toolbar measures and lays out its children with their margins, so 16dp
                         here is simply honoured — the line M3 puts a top app bar's trailing
                         element on, and the line the page content sits on. An action view would
                         instead be re-parented into the ActionMenuView, which builds fresh
                         LayoutParams and drops the margin. The dot is the chip's icon; it is
                         tinted and pulsed from code.

                         The paddings are all set explicitly so the two ends match: the dot sits
                         10+2dp from the left frame, the label ends 2+10dp from the right one. The
                         defaults are not symmetric, and the dot and the label read as one object,
                         so an uneven pair of gaps makes the chip look off-centre. -->
                    <!-- suppress ensure-min-touch-target: the chip is a status readout with a
                         details dialog behind it, not a primary control. -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/status_chip"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:text="@string/state_stopped"
                        app:chipIcon="@drawable/status_dot"
                        app:chipIconSize="10dp"
                        app:chipStartPadding="10dp"
                        app:iconStartPadding="2dp"
                        app:iconEndPadding="0dp"
                        app:textStartPadding="8dp"
                        app:textEndPadding="2dp"
                        app:chipEndPadding="10dp"
                        app:ensureMinTouchTargetSize="false" />
                </com.google.android.material.appbar.MaterialToolbar>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- ===== pages: Settings and Log =====
             Siblings swapped by the bottom bar, with a MaterialFadeThrough between them. Not a
             ViewPager2: M3 says a navigation bar's destinations are not swiped between and must
             not move laterally, because lateral motion implies they are peers in a sequence. The
             cross-fade is the transition the spec calls for. -->
        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <include layout="@layout/page_settings" />

            <include layout="@layout/page_log" />
        </FrameLayout>

        <!-- ===== actions =====
             Direct children of the CoordinatorLayout — the arrangement shrink()/extend() is built
             for, and where the component's own Behavior can see the app bar. Each pair is pinned to
             the bottom-end corner; the secondary one is slid left of the primary by a translation
             that follows its animated width (translation, so it costs no layout).

             minWidth=0dp is required, not cosmetic: the extend target is computed as
             measuredWidth - collapsedPadding*2 + extendedPadding*2. When the default minWidth
             floors that measurement, the subtraction removes padding that was never in the
             measurement, so the animation overshoots and then snaps back to the settled
             wrap-content width at the end. extendStrategy is pinned to wrap_content so the
             target never depends on a remembered pre-shrink width. -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/fab_margin"
            android:minWidth="0dp"
            app:extendStrategy="wrap_content"
            android:text="@string/action_apply"
            android:textColor="@color/fab_fg_primary"
            app:icon="@drawable/ic_restart"
            app:iconTint="@color/fab_fg_primary"
            app:backgroundTint="@color/fab_bg_primary" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/fab_margin"
            android:minWidth="0dp"
            app:extendStrategy="wrap_content"
            android:visibility="gone"
            android:text="@string/action_stop"
            android:textColor="@color/fab_fg_surface"
            app:icon="@drawable/ic_stop"
            app:iconTint="@color/fab_fg_surface"
            app:backgroundTint="@color/fab_bg_surface" />

        <!-- Log tab: always usable, so neither is ever hidden or disabled by state -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/log_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/fab_margin"
            android:minWidth="0dp"
            app:extendStrategy="wrap_content"
            android:visibility="gone"
            android:text="@string/log_copy"
            android:textColor="@color/fab_fg_primary"
            app:icon="@drawable/ic_copy"
            app:iconTint="@color/fab_fg_primary"
            app:backgroundTint="@color/fab_bg_primary" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/log_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/fab_margin"
            android:minWidth="0dp"
            app:extendStrategy="wrap_content"
            android:visibility="gone"
            android:text="@string/log_clear"
            android:textColor="@color/fab_fg_surface"
            app:icon="@drawable/ic_clear"
            app:iconTint="@color/fab_fg_surface"
            app:backgroundTint="@color/fab_bg_surface" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
