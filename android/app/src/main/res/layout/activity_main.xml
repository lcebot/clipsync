<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Overlay host. The actions and the status pill live HERE, not inside the CoordinatorLayout:
         every time one of them re-lays out (fold/unfold, text -> icon morph) the request would
         otherwise mark the CoordinatorLayout dirty, re-run the app bar behaviours and make the
         collapsing title jump or flash. As siblings their layout pass never reaches it. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ===== M3 "medium" collapsing top app bar: title scaling, insets and lift-on-scroll
                 are the component's own. ===== -->
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:liftOnScroll="true"
                app:liftOnScrollTargetViewId="@+id/page_settings">

                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/collapsing"
                    style="?attr/collapsingToolbarLayoutMediumStyle"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/collapsingToolbarLayoutMediumSize"
                    app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
                    app:titleCollapseMode="scale"
                    app:expandedTitleMarginEnd="120dp"
                    app:maxLines="1"
                    app:title="@string/app_name">

                    <com.google.android.material.appbar.MaterialToolbar
                        android:id="@+id/toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/actionBarSize"
                        app:layout_collapseMode="pin" />
                </com.google.android.material.appbar.CollapsingToolbarLayout>
            </com.google.android.material.appbar.AppBarLayout>

        <!-- ===== pages ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- ===== page: Settings ===== -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/page_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="80dp">

                <LinearLayout
                    android:id="@+id/settings_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <!-- background permission (shown only while battery optimisation still applies) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/battery_row"
                        style="?attr/materialCardViewFilledStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="?attr/colorErrorContainer">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="4dp">

                            <TextView
                                android:id="@+id/battery_text"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:paddingVertical="8dp"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnErrorContainer"
                                android:text="@string/battery_on" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/battery_fix"
                                style="?attr/borderlessButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/battery_allow" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ===== Connection ===== -->
                    <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_connection" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@+id/mode_both">

                        <!-- compact labels: smaller type and padding, single line, never ellipsised;
                             width is distributed by content (wrap_content + weight on the leftovers) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mode_both"
                            style="@style/ClipSync.Segment"
                            android:text="@string/mode_both" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mode_ddns"
                            style="@style/ClipSync.Segment"
                            android:text="@string/mode_ddns" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mode_mdns"
                            style="@style/ClipSync.Segment"
                            android:text="@string/mode_mdns" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/port_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_port">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/port"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/psk_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_weight="2"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:hint="@string/hint_psk"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/psk"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="textPassword|textNoSuggestions"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- shown while DDNS is part of the mode -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/host_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_host">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/host"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- shown while mDNS is part of the mode -->
                    <LinearLayout
                        android:id="@+id/browse_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/browse_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="mDNS browse: 4000 ms" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/browse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0"
                            android:valueTo="6"
                            android:stepSize="1"
                            android:value="3"
                            app:labelBehavior="floating"
                            app:tickVisible="true" />
                    </LinearLayout>

                    <!-- ===== Transfer limits ===== -->
                    <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_limits" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/text_kb_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_text_kb">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/text_kb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/file_mb_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_file_mb">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/file_mb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/file_mb_local_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:hint="@string/hint_file_mb_local">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/file_mb_local"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/threads_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="Parallel connections per file: 8" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/threads"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="4"
                        android:stepSize="1"
                        android:value="3"
                        app:labelBehavior="floating"
                        app:tickVisible="true" />

                    <!-- ===== Received files ===== -->
                    <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_files" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/path_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_path"
                        app:helperText="@string/helper_path">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/path"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/keep_hours_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_keep_hours">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/keep_hours"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/keep_mb_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:hint="@string/hint_keep_mb">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/keep_mb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- ===== page: Log ===== -->
            <LinearLayout
                android:id="@+id/page_log"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:paddingHorizontal="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/log_copy"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_copy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/log_clear"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_clear" />
                </LinearLayout>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/log_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="?attr/colorSurfaceContainer"
                    android:clipToPadding="false"
                    android:paddingBottom="80dp"
                    android:scrollbars="vertical">

                    <TextView
                        android:id="@+id/log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurface" />
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>

            </FrameLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- ===== trailing actions, overlaying the app bar =====
             Laid out once, right-aligned at the top of a box as tall as the expanded app bar; the
             expanded / collapsed arrangement is pure translation (see MainActivity.morphButtons):
             stacked vertically while the bar is open, side by side once it is collapsed. -->
        <FrameLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="?attr/collapsingToolbarLayoutMediumSize"
            android:layout_gravity="top|end"
            android:paddingEnd="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stop"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                app:icon="@drawable/ic_stop"
                app:iconSize="24dp"
                app:insetTop="0dp"
                app:insetBottom="0dp"
                android:text="@string/action_stop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/apply"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                app:icon="@drawable/ic_restart"
                app:iconSize="24dp"
                app:insetTop="0dp"
                app:insetBottom="0dp"
                android:text="@string/action_apply" />
        </FrameLayout>

        <!-- ===== status pill (both pages) =====
             fixed 84dp tall in every state; folded it becomes an 84dp rounded square with the dot
             centred, unfolded the dot slides left and the three text lines appear on its right -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/status_pill"
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="wrap_content"
            android:layout_height="84dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="?attr/colorSecondaryContainer">

            <LinearLayout
                android:id="@+id/status_inner"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp">

                    <View
                        android:id="@+id/status_halo"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/status_dot"
                        android:alpha="0.35" />

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:background="@drawable/status_dot" />
                </FrameLayout>

                <!-- three lines: kind, peer name, address -->
                <LinearLayout
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:singleLine="true"
                        android:text="@string/state_stopped" />

                    <TextView
                        android:id="@+id/status_host"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:maxWidth="280dp"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/status_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:fontFamily="monospace"
                        android:maxWidth="280dp"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
