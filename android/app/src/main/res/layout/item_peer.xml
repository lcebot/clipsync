<?xml version="1.0" encoding="utf-8"?>
<!-- One entry of the direct-addresses list. The remove control is the field's own trailing icon
     rather than a button in a column beside it: it belongs to this row and to nothing else.
     On the last remaining row MainActivity hides it: zero addresses is what the Direct switch is
     for, so the row cannot be removed, and TextInputLayout offers no way to disable just the
     trailing icon without reaching into its internals.
     The hint is replaced per row by MainActivity ("Address 1", "Address 2", …) — every row reading
     the same hint leaves a screen reader with three identical fields. -->
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    tools:hint="Address 1"
    app:endIconMode="custom"
    app:endIconDrawable="@drawable/ic_remove"
    app:endIconContentDescription="@string/peer_remove">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/peer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:singleLine="true" />
</com.google.android.material.textfield.TextInputLayout>
