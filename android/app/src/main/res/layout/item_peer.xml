<?xml version="1.0" encoding="utf-8"?>
<!-- One entry of the Direct connections list. The remove control is the field's own trailing icon
     rather than a button in a column beside it: it belongs to this row and to nothing else.
     On the last remaining row AddressList hides it: zero addresses is what the Direct connections
     switch is for, so the row cannot be removed, and TextInputLayout offers no way to disable just the
     trailing icon without reaching into its internals.
     The hint is replaced per row by AddressList ("Address 1", "Address 2", etc.); every row reading
     the same hint leaves a screen reader with three identical fields.

     errorIconDrawable is cleared because TextInputLayout puts the error icon in the same trailing
     slot and hides the end icon while it shows (EndCompoundLayout.updateEndLayoutVisibility), which
     would take the remove control away exactly when it is most wanted: deleting the row is the most
     likely fix for an address that does not validate. The error is still carried by the red outline
     and the message beneath, so only redundant emphasis is lost.
     endIconCheckable is off because removing a row is an action, not a state, and TextInputLayout
     defaults an XML-declared custom end icon to checkable, which a screen reader then announces as
     a checkbox. -->
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_seam"
    tools:hint="Address 1"
    app:endIconMode="custom"
    app:endIconDrawable="@drawable/ic_remove"
    app:endIconContentDescription="@string/peer_remove"
    app:endIconCheckable="false"
    app:errorIconDrawable="@null">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/peer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:singleLine="true" />
</com.google.android.material.textfield.TextInputLayout>
