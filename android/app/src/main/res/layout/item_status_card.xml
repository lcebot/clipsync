<?xml version="1.0" encoding="utf-8"?>
<!-- One device in the peer sheet: a peer that is up, or a target that is not.

     A card, and the same filled card the settings page uses, so the two surfaces read as one app.
     A labelled field per value, such as id, type, address, lets the eye compare cards at a glance instead
     of parsing a string where several values run together.

     The whole card is the touch target and copies the device's details (see StatusSheet.makeCard),
     and StatusSheet labels that click action for a screen reader, since nothing in the card's own
     text says what pressing it would do.

     The horizontal margin is the sheet's gutter so the card's edge lines up with the sheet's title
     and its group headings rather than bulging out to the left of them. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/sheet_gutter"
    android:layout_marginBottom="@dimen/spacing_group"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <!-- The name carries the card on its own, so it is a title and not a body line. -->
        <TextView
            android:id="@+id/card_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <!-- 8dp from the title, and the fields themselves 4dp apart (set on each row): a field is
             closer to its neighbours than the group is to the name it belongs to, which is what makes
             them read as one block rather than four separate lines. -->
        <LinearLayout
            android:id="@+id/card_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_group"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
