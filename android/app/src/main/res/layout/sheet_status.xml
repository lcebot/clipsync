<?xml version="1.0" encoding="utf-8"?>
<!-- Peers, shown when the status chip is tapped.
     A bottom sheet rather than a dialog for two reasons: M3 reserves dialogs for decisions that
     need an answer, while this is supplementary content you glance at and dismiss — and
     BottomSheetDialog is one of the few components with predictive back built in, so the gesture
     animates the sheet back down without a line of animation code.

     The body is empty here and filled by MainActivity, because its length is the number of peers
     and that is not known until it opens. Scrollable, because "three addresses of which one is
     failing" is the case this exists for and it is not the shortest one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- the spec's own affordance: it says the sheet is draggable, and it is a real component -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/sheet_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- 8dp from the last card, which already carries 8dp of its own: the hint is about the cards, so
         it sits closer to them than the sheet's own bottom padding puts it from the edge. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="24dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="@string/dialog_tap_to_copy" />
</LinearLayout>
