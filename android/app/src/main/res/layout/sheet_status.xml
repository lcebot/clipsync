<?xml version="1.0" encoding="utf-8"?>
<!-- Peers, shown when the status chip is tapped.
     A bottom sheet rather than a dialog for two reasons: M3 reserves dialogs for decisions that
     need an answer, while this is supplementary content you glance at and dismiss — and
     BottomSheetDialog is one of the few components with predictive back built in, so the gesture
     animates the sheet back down without a line of animation code.

     The body is empty here and filled by StatusSheet, because its length is the number of peers
     and that is not known until it opens. Scrollable, because "three addresses of which one is
     failing" is the case this exists for and it is not the shortest one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/page_gutter">

    <!-- the spec's own affordance: it says the sheet is draggable, and it is a real component -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/sheet_gutter"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <!-- Under the title, not at the foot of the sheet. A bottom sheet arrives from the bottom edge,
         so its last line is the one the animation sweeps past and the one a partially expanded sheet
         is most likely to cut off — the worst place to put the instruction for using everything
         above it. Here it reads as a subtitle to "Peers", which is what it is. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/sheet_gutter"
        android:paddingTop="2dp"
        android:paddingBottom="@dimen/spacing_field"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="@string/dialog_tap_to_copy" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/sheet_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
