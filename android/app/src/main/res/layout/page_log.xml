<?xml version="1.0" encoding="utf-8"?>
<!-- The Log page. One selectable TextView on purpose: a log is only useful in a bug report if it
     can be selected and copied by hand. The buffer is capped at 512 entries (Logger.MAX_ENTRIES),
     which is what keeps a single TextView from becoming a layout problem.
     The bottom padding clears the FAB pair. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_log"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:clipToPadding="false"
    android:paddingBottom="80dp"
    android:scrollbars="vertical"
    android:visibility="gone">

    <TextView
        android:id="@+id/log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:fontFamily="monospace"
        android:textIsSelectable="true"
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurface" />
</androidx.core.widget.NestedScrollView>
