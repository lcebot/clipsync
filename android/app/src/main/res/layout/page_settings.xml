<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings page, pulled into activity_main with <include>. Bottom padding clears the FABs. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="80dp">

    <LinearLayout
        android:id="@+id/settings_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- background permission (shown only while battery optimisation still applies) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/battery_row"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="?attr/colorErrorContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/battery_text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnErrorContainer"
                    android:text="@string/battery_on" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/battery_fix"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_allow" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Connection =====
             Every group of controls on this page sits in one filled card, with the section title
             outside it. A card marks where one group ends and the next begins, which is what makes
             a switch and the controls it governs read as one thing rather than as neighbours that
             happen to be adjacent. The cards holding a switch never hide — they hold the switch —
             only the dependent content inside them does. -->
        <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_connection" />

        <!-- Port and PSK first: the two identity fields above the two discovery blocks read as
             "who we are, then how we find each other". -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/ClipSync.CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/port_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_port">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/port"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/psk_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_psk"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/psk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="textPassword|textNoSuggestions"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Its own button under the field, not one of the field's icon slots. The trailing
                     slot is the reveal toggle, and the leading slot — which does fit — puts an action
                     where a text field's leading icon is read as decoration.

                     Start-aligned, flush with the card body, no margin, and NO ICON — that last part
                     is what makes it line up. Measured from the card's edge: the button's left edge
                     is at the body's 12dp, ?attr/borderlessButtonStyle under Expressive adds 16dp of
                     content padding, so the label starts at 28dp — exactly where an outlined box puts
                     its text, that box insetting by its own 16dp. Same column as every field and both
                     switch titles, with no alignment constant anywhere.
                     An icon breaks it, and not for a reason a layout can fix: Material Symbols are
                     drawn on a 24dp grid with a trim area, so "add" spans x=5..19 of its viewport and
                     its ink starts ~4dp inside the 20dp the button draws it at. Trimming the asset
                     would put this one icon on a different optical grid from every other icon in the
                     app, and a -4dp margin would hardcode a constant read off one drawable's path
                     data that silently stops being right the moment the drawable changes. So the
                     label holds the column and the icon goes. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/psk_random"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/psk_generate" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The two switches are named for HOW a peer is found, not for the route to it: a listed
             address is very often a LAN address too. Named that way, neither needs a subtitle.

             Two things are spelled out on both switches rather than inherited:
             - gravity. MaterialSwitch inherits center_vertical|start from android:Widget.CompoundButton,
               but SwitchCompat's own layout falls back to TOP for any gravity missing a vertical bit,
               so a later "align the switch to the end" would silently drag the label to the top.
             - paddingStart of 16dp. A bare switch label starts at the view's edge, while every text
               field on this page insets its text by 16dp, which left the switch titles hanging 16dp
               to the left of every other line of text in the section. SwitchCompat positions the
               track from getPaddingRight(), so a start padding moves the label without moving the
               track off the right edge. -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout style="@style/ClipSync.CardBody.Rows">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/discovery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|start"
                    android:paddingStart="16dp"
                    android:text="@string/switch_discovery"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <!-- mDNS stays on the slider under a switch named in plain words: the switch says
                     what it is for, the slider names the thing it actually times. The label takes the
                     same 16dp inset as the switch title above it; the slider does not, because its
                     track already insets itself by the thumb radius and it is meant to span the card. -->
                <LinearLayout
                    android:id="@+id/browse_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/browse_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="mDNS browse timeout: 4000 ms" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/browse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="6"
                        android:stepSize="1"
                        android:value="3"
                        app:labelBehavior="floating"
                        app:tickVisible="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout style="@style/ClipSync.CardBody.Rows">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/direct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|start"
                    android:paddingStart="16dp"
                    android:text="@string/switch_direct"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <!-- rows are inflated from item_peer.xml; at least one always remains -->
                <LinearLayout
                    android:id="@+id/peers_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- No icon, for the reason given on the Generate button above: the label is what
                     holds the 28dp text column, and a Material Symbol's own trim area would push the
                     ink off it. The label carries the "+". -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/peer_add"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/peer_add" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Transfer limits ===== -->
        <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_limits" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/ClipSync.CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/text_kb_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_text_kb">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/text_kb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/file_mb_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_file_mb">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/file_mb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/file_mb_local_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:hint="@string/hint_file_mb_local">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/file_mb_local"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/threads_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Parallel connections per file: 8" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/threads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="4"
                    android:stepSize="1"
                    android:value="3"
                    app:labelBehavior="floating"
                    app:tickVisible="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Received files ===== -->
        <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_files" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout style="@style/ClipSync.CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/path_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_path"
                    app:helperText="@string/helper_path">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keep_hours_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_keep_hours">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/keep_hours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keep_mb_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_keep_mb">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/keep_mb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
