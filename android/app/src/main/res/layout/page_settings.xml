<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings page, pulled into activity_main with <include>. Bottom padding clears the FABs. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="80dp">

    <LinearLayout
        android:id="@+id/settings_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- background permission (shown only while battery optimisation still applies) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/battery_row"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="?attr/colorErrorContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/battery_text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnErrorContainer"
                    android:text="@string/battery_on" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/battery_fix"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_allow" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Connection =====
             Every group of controls on this page sits in one filled card, with the section title
             outside it. A card marks where one group ends and the next begins, which is what makes
             a switch and the controls it governs read as one thing rather than as neighbours that
             happen to be adjacent. The cards holding a switch never hide — they hold the switch —
             only the dependent content inside them does. -->
        <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_connection" />

        <!-- Port and PSK first: the two identity fields above the two discovery blocks read as
             "who we are, then how we find each other". -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/ClipSync.CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/port_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_port">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/port"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/psk_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_psk"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/psk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="textPassword|textNoSuggestions"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Its own button under the field, not one of the field's icon slots. The trailing
                     slot is the reveal toggle, and the leading slot — which does fit — puts an action
                     where a text field's leading icon is read as decoration.

                     The label has to land in the same column as the fields' own labels above it —
                     Port, PSK key — which an outlined box insets by 16dp. Three attributes make that
                     true without depending on what the theme's text-button style happens to be:
                       minWidth=0dp   a MaterialButton inherits a min width from the AppCompat button
                                      chain, and a label shorter than it leaves the button stretched;
                       gravity=start  because the inherited gravity is centre, so any stretch — from
                                      minWidth or from a later match_parent — pushes the label right;
                       paddingStart   stated as the field inset itself, rather than trusted to match.
                     insetLeft is zeroed with it: MaterialButtonHelper adds insetLeft to paddingStart
                     and draws the background inside it, so a non-zero inset would offset the content
                     while leaving the touch target where it was.
                     No icon, deliberately, and not for a reason a layout could fix: Material Symbols
                     are drawn on a 24dp grid with a trim area, so "add" spans x=5..19 of its viewport
                     and its ink begins ~4dp inside the 20dp the button draws it at. Trimming the asset
                     would put that one icon on a different optical grid from every other icon in the
                     app; a -4dp margin would hardcode a number read off one drawable's path data. An
                     icon can come back once the row above is confirmed aligned. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/psk_random"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="start|center_vertical"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/psk_generate" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The two switches are named for HOW a peer is found, not for the route to it: a listed
             address is very often a LAN address too. Named that way, neither needs a subtitle.

             Each switch is its own row at PAGE level, outside the card it governs, and the card
             follows 4dp under it. That is the hierarchy: the switch turns a group on and off, so it
             belongs one level up from the group's contents, next to the section title and flush with
             the card's edge — page padding and nothing added. Inside the card, contents are one level
             in. Trying instead to line a switch label up with the text inside the card's fields meant
             hand-carrying a 12+16dp inset around, which is the kind of constant that goes stale.
             It also means the whole card can hide when the switch is off, rather than a wrapper inside
             a card that must stay visible to keep the switch on screen.

             gravity is still spelled out: MaterialSwitch inherits center_vertical|start from
             android:Widget.CompoundButton, but SwitchCompat's layout falls back to TOP for any gravity
             missing a vertical bit, so a later "align the switch to the end" would silently drag the
             label to the top. minHeight is the M3 one-line list-item height; the switch's own default
             is the 48dp touch target, which is a minimum, not a row. -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/discovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical|start"
            android:minHeight="56dp"
            android:text="@string/switch_discovery"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <!-- mDNS stays on the slider under a switch named in plain words: the switch says what it is
             for, the slider names the thing it actually times. The label takes the 16dp inset that an
             outlined box gives its own text, so it shares that column; the slider does not, because its
             track already insets itself by the thumb radius and is meant to span the card. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/discovery_card"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <LinearLayout style="@style/ClipSync.CardBody">

                <TextView
                    android:id="@+id/browse_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="mDNS browse timeout: 4000 ms" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/browse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="6"
                    android:stepSize="1"
                    android:value="3"
                    app:labelBehavior="floating"
                    app:tickVisible="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/direct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical|start"
            android:minHeight="56dp"
            android:text="@string/switch_direct"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/direct_card"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <LinearLayout style="@style/ClipSync.CardBody">

                <!-- rows are inflated from item_peer.xml; at least one always remains -->
                <LinearLayout
                    android:id="@+id/peers_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Same five attributes and the same reasoning as the Generate button above. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/peer_add"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="start|center_vertical"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/peer_add" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Transfer limits ===== -->
        <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_limits" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/ClipSync.CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/text_kb_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_text_kb">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/text_kb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/file_mb_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_file_mb">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/file_mb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/file_mb_local_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:hint="@string/hint_file_mb_local">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/file_mb_local"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/threads_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Parallel connections per file: 8" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/threads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="4"
                    android:stepSize="1"
                    android:value="3"
                    app:labelBehavior="floating"
                    app:tickVisible="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Received files ===== -->
        <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_files" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout style="@style/ClipSync.CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/path_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_path"
                    app:helperText="@string/helper_path">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keep_hours_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_keep_hours">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/keep_hours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keep_mb_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_keep_mb">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/keep_mb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
