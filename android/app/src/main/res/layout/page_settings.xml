<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings page, pulled into activity_main with <include>. Bottom padding clears the FABs. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="80dp">

    <LinearLayout
        android:id="@+id/settings_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- background permission (shown only while battery optimisation still applies) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/battery_row"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="?attr/colorErrorContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/battery_text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnErrorContainer"
                    android:text="@string/battery_on" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/battery_fix"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_allow" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Connection =====
             Every group of controls on this page sits in one filled card, with the section title
             outside it. A card marks where one group ends and the next begins, which is what makes
             a switch and the controls it governs read as one thing rather than as neighbours that
             happen to be adjacent. The cards holding a switch never hide — they hold the switch —
             only the dependent content inside them does. -->
        <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_connection" />

        <!-- Port and PSK first: the two identity fields above the two discovery blocks read as
             "who we are, then how we find each other". -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/ClipSync.CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/port_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_port">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/port"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/psk_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_psk"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/psk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="textPassword|textNoSuggestions"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Its own button under the field, not one of the field's icon slots. The trailing
                     slot is the reveal toggle, and the leading slot — which does fit — puts an action
                     where a text field's leading icon is read as decoration.

                     ClipSync.SettingsButton carries the geometry; themes.xml says why each of its
                     items is there. Now that the button is outlined, its border lines up with the
                     fields' borders and the icon is free to come back: the earlier problem — a Material
                     Symbol's trim area putting the icon's ink ~4dp off a text column — only mattered
                     while the label was the thing holding that column.
                     marginTop is 4dp, not 8dp: the button's background is drawn 4dp inside its view
                     box (containerInsetTop), so 4dp of margin reads as the same 8dp gap the fields
                     leave between each other. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/psk_random"
                    style="@style/ClipSync.SettingsButton"
                    android:layout_marginTop="4dp"
                    android:text="@string/psk_generate"
                    app:icon="@drawable/ic_dice" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The two switches are named for HOW a peer is found, not for the route to it: a listed
             address is very often a LAN address too. Named that way, neither needs a subtitle.

             Each switch is its own card, outside the card it governs, with the group's card 2dp under
             it — just a seam, so the two read as one unit while staying two surfaces. The switch turns
             a whole group on and off, so it sits beside the group rather than inside it, which also
             means the group's card is the hideable thing and the switch is never inside what it hides.
             Its card takes the same fill as the group cards and the same 12dp body inset, applied here
             as a margin on the switch itself rather than padding on a wrapper: that puts the label on
             the fields' box-left edge and the track's right end on their box-right edge, for free.
             The gap ABOVE a switch card is the 6dp the section title already leaves above its own
             card — the switch introduces a group, so it is spaced like a heading. Anything larger made
             the groups inside Connection look further apart than Connection is from Transfer limits.

             gravity is still spelled out: MaterialSwitch inherits center_vertical|start from
             android:Widget.CompoundButton, but SwitchCompat's layout falls back to TOP for any gravity
             missing a vertical bit, so a later "align the switch to the end" would silently drag the
             label to the top. No minHeight: the switch's own 48dp touch target is the row height, and
             a 56dp list-item height on top of it was what made these rows look oversized. -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/discovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:gravity="center_vertical|start"
                android:text="@string/switch_discovery"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </com.google.android.material.card.MaterialCardView>

        <!-- mDNS stays on the slider under a switch named in plain words: the switch says what it is
             for, the slider names the thing it actually times. The label carries no inset of its own,
             so it sits where the Parallel-connections label further down sits. Both sliders keep the
             horizontal padding their own style gives them: that space is the thumb's, and a track run
             out to the card body's edge would clip the thumb at 0 and at max. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/discovery_card"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">

            <LinearLayout style="@style/ClipSync.CardBody">

                <TextView
                    android:id="@+id/browse_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="mDNS browse timeout: 4000 ms" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/browse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="6"
                    android:stepSize="1"
                    android:value="3"
                    app:labelBehavior="floating"
                    app:tickVisible="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/direct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:gravity="center_vertical|start"
                android:text="@string/switch_direct"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/direct_card"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">

            <LinearLayout style="@style/ClipSync.CardBody">

                <!-- rows are inflated from item_peer.xml; at least one always remains -->
                <LinearLayout
                    android:id="@+id/peers_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/peer_add"
                    style="@style/ClipSync.SettingsButton"
                    android:layout_marginTop="4dp"
                    android:text="@string/peer_add"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Config.from() refuses a config with both switches off, so Apply has to refuse it too, and
             something has to say why: with both off, both group cards are hidden and there is no field
             left to hang an error on. Placed under the pair rather than on either switch, because
             neither is wrong on its own. Styled as a TextInputLayout error would be — bodySmall on
             colorError — and indented to the fields' label column so it reads as one. -->
        <TextView
            android:id="@+id/paths_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="28dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:text="@string/paths_none"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- ===== Transfer limits ===== -->
        <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_limits" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/ClipSync.CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/text_kb_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_text_kb">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/text_kb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/file_mb_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_file_mb">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/file_mb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/file_mb_local_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:hint="@string/hint_file_mb_local">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/file_mb_local"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/threads_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Parallel connections per file: 8" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/threads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="4"
                    android:stepSize="1"
                    android:value="3"
                    app:labelBehavior="floating"
                    app:tickVisible="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Received files ===== -->
        <TextView style="@style/ClipSync.SectionTitle" android:text="@string/section_files" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout style="@style/ClipSync.CardBody">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/path_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_path"
                    app:helperText="@string/helper_path">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keep_hours_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_keep_hours">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/keep_hours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keep_mb_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_keep_mb">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/keep_mb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
