<?xml version="1.0" encoding="utf-8"?>
<!-- FAB container: M3 disabled treatment (12 % onSurface) instead of a view-wide alpha, which
     would fight the component's own show()/hide() alpha animations. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="?attr/colorOnSurface" android:alpha="0.12" />
    <item android:color="?attr/colorPrimaryContainer" />
</selector>
