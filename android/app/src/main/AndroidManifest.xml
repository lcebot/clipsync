<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- lets the app ask to be exempted from battery optimisation (system confirmation dialog) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".ClipSyncApp"
        android:label="@string/app_name"
        android:description="@string/app_desc"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ClipSync"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <!-- libxposed API 102 module: declared by META-INF/xposed/* (java_init.list, scope.list,
             module.prop). Nothing to declare here; the classic API is not supported. -->


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: it is reached from Settings and from the first run, never from outside.
             parentActivityName so the system knows where up goes, even though the only way out is
             a choice or Back. -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- specialUse: no 6h/24h cap (unlike dataSync on Android 15).
             Own process (":sync"): swiping the UI task away or a ROM killing the main process
             does not touch the sync; stopWithTask=false for the same reason.

             NOT exported, and this is a security decision rather than tidiness. The service accepts
             ACTION_CLIP and pushes whatever text it carries to every paired device, without asking
             where the intent came from. Exported, any app on the phone could call
             startService(ACTION_CLIP) and put a phishing link or a swapped payment address on the
             user's clipboard on every device at once.

             The one legitimate outside caller is xposed/Common.pushClip, which runs INSIDE
             system_server and calls startService with SYSTEM_UID. That is allowed, and it is
             allowed twice over, verified against AOSP android15-release:

               services/.../am/ActiveServices.java#retrieveServiceLocked
                   if (mAm.checkComponentPermission(r.permission, callingPid, callingUid,
                           r.appInfo.uid, r.exported) != PERMISSION_GRANTED) { if (!r.exported) ... }

               services/.../am/ActivityManagerService.java#checkComponentPermission
                   if (pid == MY_PID) return PERMISSION_GRANTED;       // MY_PID *is* system_server
                   ... else delegates to:

               core/java/android/app/ActivityManager.java#checkComponentPermission
                   // Root, system server get to do everything.
                   if (canAccessUnexportedComponents(uid)) return PERMISSION_GRANTED;
                   ...
                   // If the target is not exported, then nobody else can get to it.
                   if (!exported) return PERMISSION_DENIED;

             canAccessUnexportedComponents(uid) is appId == ROOT_UID || appId == SYSTEM_UID, and it
             runs BEFORE the !exported branch. So system_server (uid 1000, and in fact pid ==
             MY_PID) and a real root caller (`su -c am startservice`, uid 0) both get through;
             `adb shell am startservice` does NOT, because shell is uid 2000 and hits the !exported
             branch. Every other app on the device is locked out, which is the point.

             The app's own MainActivity and BootReceiver are the same uid (isSameApp) and were
             never subject to the check at all.

             What this does NOT cover: the plain startService push only lands while the service is
             already started (r.startRequested), because the background-start gate in
             ActiveServices#startServiceLocked is evaluated against the TARGET app's uid, not the
             caller's. That matches SyncService.onStartCommand, which ignores ACTION_CLIP unless
             `started`.

             Do NOT "fix" a missing push by re-exporting: that restores the hole above, and
             Binder.getCallingUid() cannot replace the check: onStartCommand does not run inside a
             binder transaction, so it returns this app's own uid (framework javadoc: "If the
             current thread is not currently executing an incoming transaction, then its own UID is
             returned"). The only real alternative is a signature-level <permission> declared here
             and held by the module. -->
        <!-- PROPERTY_SPECIAL_USE_FGS_SUBTYPE is a Play-console/policy requirement ("apps must
             declare a service-level <property> as a hint of what the exact use case here is") and
             is not enforced by AOSP at runtime; ActiveServices never reads it. Declared anyway. -->
        <service
            android:name=".SyncService"
            android:exported="false"
            android:process=":sync"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="clipboard sync with PC" />
        </service>

        <!-- also the "auto-start enabled" switch: Stop in the app disables this component, Apply
             re-enables it; the system_server watchdog (xposed.Entry) only restarts the service
             while it is enabled -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:process=":sync">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
